# Copie para .env.local e preencha. Só variáveis públicas aqui (vão para o navegador).
# NUNCA coloque a secret key / service_role em variáveis VITE_*.

# Local: valores impressos por `pnpm db:start` (API URL e Publishable key)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Domínio dos e-mails técnicos (usuário "leo" -> leo@<domínio>).
# Em produção use um domínio controlado pelo projeto. O seed local usa este:
VITE_AUTH_EMAIL_DOMAIN=contas.baralhoresenha.test
